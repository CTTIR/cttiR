{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CTTIR reviewed workflow approval decisions",
  "description": "Reviewer decisions keyed to an exact package source_hash. A decision counts only when the catalog revision evidences every requirement; see approval_coverage().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "decisions": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approval_id",
          "package",
          "version",
          "source_hash",
          "role",
          "profile",
          "adapter_id",
          "adapter_version",
          "status",
          "required_callables",
          "required_topics",
          "required_documents",
          "fixtures",
          "decided_at",
          "rights_basis"
        ],
        "properties": {
          "approval_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "package": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9.]{0,99}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+([.-][0-9]+)+$"
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "profile": {
            "enum": [
              "cttir_specialist",
              "hybrid",
              "standard_reflowR"
            ]
          },
          "adapter_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
          },
          "adapter_version": {
            "type": "string",
            "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$"
          },
          "status": {
            "enum": [
              "approved",
              "pending",
              "revoked"
            ]
          },
          "required_callables": {
            "type": "array",
            "minItems": 0,
            "maxItems": 2000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\s]+$"
            }
          },
          "required_topics": {
            "type": "array",
            "minItems": 0,
            "maxItems": 2000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required_documents": {
            "type": "array",
            "minItems": 0,
            "maxItems": 2000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?![/\\\\])(?!.*(^|/)\\.\\.?(/|$))(?!.*:)[A-Za-z0-9._+/ -]{1,512}$"
            }
          },
          "fixtures": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "test_file",
                "test_name",
                "result",
                "run_at"
              ],
              "properties": {
                "test_file": {
                  "type": "string",
                  "pattern": "^(?![/\\\\])(?!.*(^|/)\\.\\.?(/|$))(?!.*:)[A-Za-z0-9._+/ -]{1,512}$"
                },
                "test_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "result": {
                  "enum": [
                    "pass",
                    "fail",
                    "error",
                    "skip"
                  ]
                },
                "run_at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
                }
              }
            }
          },
          "decided_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          },
          "rights_basis": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "required_methods": {
            "type": "array",
            "description": "S3 method implementations (for example tidy.lm) whose static registration and documentation must be evidenced.",
            "maxItems": 2000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\s]+$"
            }
          },
          "required_objects": {
            "type": "array",
            "description": "Documented exported non-function objects (for example datasets) used by generated code.",
            "maxItems": 2000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\s]+$"
            }
          }
        }
      }
    }
  }
}
