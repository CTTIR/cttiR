{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cttir customization input v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "primary_research",
            "secondary_research",
            "methods",
            "review",
            "software",
            "mixed",
            "other"
          ]
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "enum": [
            "en",
            "de"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "research": {
      "type": "object",
      "properties": {
        "design": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ethics_status": {
          "type": "string",
          "enum": [
            "unknown",
            "not_applicable",
            "pending",
            "approved"
          ]
        },
        "analysis_role": {
          "type": "string",
          "enum": [
            "primary_analysis",
            "secondary_analysis",
            "exploratory",
            "unknown"
          ]
        },
        "data_origin": {
          "type": "string",
          "enum": [
            "new_collection",
            "existing_dataset",
            "literature",
            "mixed",
            "unknown"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "research_class": {
            "type": "string",
            "enum": [
              "primary_research",
              "secondary_research",
              "methods",
              "software",
              "other",
              "unknown"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "original_article",
              "systematic_review",
              "scoping_review",
              "meta_analysis",
              "methods",
              "protocol",
              "software",
              "narrative_review",
              "other"
            ]
          },
          "analysis_role": {
            "type": "string",
            "enum": [
              "primary_analysis",
              "secondary_analysis",
              "exploratory",
              "unknown"
            ]
          },
          "data_origin": {
            "type": "string",
            "enum": [
              "new_collection",
              "existing_dataset",
              "literature",
              "mixed",
              "unknown"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "workflow": {
      "type": "object",
      "properties": {
        "pipeline": {
          "type": "string",
          "enum": [
            "targets",
            "none"
          ]
        },
        "environment": {
          "type": "string",
          "enum": [
            "renv",
            "none"
          ]
        },
        "git": {
          "type": "boolean"
        },
        "prepare_environment": {
          "type": "boolean"
        },
        "network": {
          "type": "string",
          "enum": [
            "offline",
            "allowed"
          ]
        },
        "reporting": {
          "type": "string",
          "enum": [
            "generic",
            "quarto",
            "rmarkdown",
            "workflowr",
            "reflowR"
          ]
        },
        "readiness": {
          "type": "string",
          "enum": [
            "scaffold_ready",
            "environment_ready",
            "demo_verified",
            "data_ready",
            "analysis_ready"
          ]
        },
        "profile": {
          "type": "string",
          "enum": [
            "auto",
            "cttir_specialist",
            "hybrid",
            "standard_reflowR"
          ]
        },
        "project_backend": {
          "type": "string",
          "enum": [
            "cttir",
            "reflowR"
          ]
        },
        "table_backend": {
          "type": "string",
          "enum": [
            "DescrTab2",
            "gtsummary",
            "gt",
            "none"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "logical_uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "format": {
            "type": [
              "string",
              "null"
            ]
          },
          "access_class": {
            "type": "string",
            "enum": [
              "unknown",
              "public",
              "restricted"
            ]
          },
          "checksum": {
            "type": [
              "string",
              "null"
            ]
          },
          "checksum_status": {
            "type": "string",
            "enum": [
              "unknown",
              "recorded",
              "verified"
            ]
          },
          "schema_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "refresh": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object"
    },
    "analysis": {
      "type": "object",
      "properties": {
        "aim": {
          "type": "string",
          "enum": [
            "descriptive",
            "explanatory",
            "predictive",
            "causal",
            "unknown"
          ]
        },
        "outcome_family": {
          "type": "string",
          "enum": [
            "continuous",
            "binary",
            "count",
            "ordinal",
            "time_to_event",
            "other",
            "unknown"
          ]
        },
        "unit_structure": {
          "type": "string",
          "enum": [
            "independent",
            "paired",
            "clustered",
            "longitudinal",
            "unknown"
          ]
        },
        "engine": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved": {
          "type": "boolean"
        },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "data_source_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "outcome": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "subject": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "time": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "event": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "predictors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "uniqueItems": true,
              "maxItems": 50
            },
            "event_value": {
              "type": [
                "string",
                "integer",
                "null"
              ],
              "maxLength": 128
            },
            "non_event_value": {
              "type": [
                "string",
                "integer",
                "null"
              ],
              "maxLength": 128
            },
            "estimand": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 65536
            },
            "time_origin": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 65536
            },
            "time_unit": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 65536
            },
            "missing_data": {
              "enum": [
                "unknown",
                "fail",
                "complete_case"
              ]
            }
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "figures": {
      "title": "CTTIR figure policy",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "continuous_palette": {
          "enum": [
            "viridis",
            "cividis"
          ],
          "default": "viridis"
        },
        "categorical_provider": {
          "const": "RColorBrewer",
          "default": "RColorBrewer"
        },
        "categorical_palette": {
          "type": "string",
          "default": "Dark2"
        },
        "diverging_palette": {
          "type": "string",
          "default": "BrBG"
        },
        "colourblind_friendly_only": {
          "const": true,
          "default": true
        },
        "redundant_encoding_required": {
          "const": true,
          "default": true
        },
        "panel_composer": {
          "const": "patchwork",
          "default": "patchwork"
        },
        "checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "protanopia",
              "deuteranopia",
              "tritanopia",
              "grayscale"
            ]
          },
          "default": [
            "protanopia",
            "deuteranopia",
            "tritanopia",
            "grayscale"
          ]
        },
        "named_colours": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
          }
        },
        "na_colour": {
          "type": "string",
          "default": "#808080"
        }
      }
    },
    "ecosystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seurat_for_relevant_gaps": {
          "type": "boolean",
          "default": true
        },
        "require_role_approval": {
          "const": true,
          "default": true
        },
        "modality": {
          "type": "string"
        }
      }
    }
  },
  "required": [],
  "additionalProperties": false
}
